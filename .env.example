# ==============================================================================
# ENVIRONMENT CONFIGURATION MANIFEST
# 
# Required environment variables:
#   SECRET_KEY:             Cryptographic key used to sign sessions, CSRF tokens, and password
#                           reset links. Must be kept secret and unique per environment.
#   DJANGO_SETTINGS_MODULE: The settings module to be used when the application runs
#                           (e.g., config.settings.local or config.settings.production).
#   DATABASE_URL:           Connection string for the database (e.g. SQLite for local dev, PostgreSQL for prod).
#   ALLOWED_HOSTS:          Comma-separated domains WITHOUT scheme (e.g., app-name.herokuapp.com).
#   CSRF_TRUSTED_ORIGINS:   Comma-separated URLs WITH scheme (e.g., https://app-name.herokuapp.com).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Development Configuration
# ------------------------------------------------------------------------------
SECRET_KEY="replace-me-with-a-secure-dev-key"
DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=sqlite:///db.sqlite3
# Defaults provided in the local settings module for ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS


# ------------------------------------------------------------------------------
# 2. Production Configuration (Reference template for Heroku / Prod Config Vars)
# ------------------------------------------------------------------------------
# SECRET_KEY=replace-with-strong-production-key
# DJANGO_SETTINGS_MODULE=config.settings.production
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
# ALLOWED_HOSTS=app-url-with-no-prefix.herokuapp.com
# CSRF_TRUSTED_ORIGINS=https://app-url-with-https-prefix.herokuapp.com